# Shenava realtime — example environment. Copy to .env and edit.
# Every key here is optional; the defaults in shenava_realtime/config.py apply
# when a key is absent. Exported shell variables always win over this file.

# --- Model ------------------------------------------------------------------
# Local trusted .nemo checkpoint (relative paths resolve against the repo root).
SHENAVA_MODEL_PATH=./shenava-koochik/shenava-koochik-v1.5.nemo
# Hub name, used only when downloading is explicitly permitted below.
SHENAVA_MODEL_NAME=Reza2kn/Shenava-Koochik-v1.5
# Never provision over the network unless this is explicitly enabled.
SHENAVA_ALLOW_DOWNLOAD=0
SHENAVA_DEVICE=auto
SHENAVA_NUM_THREADS=4

# --- Recognition head -------------------------------------------------------
# ctc  = production default
# rnnt = experimental, hybrid checkpoints only (fails clearly otherwise)
# auto = explicitly the default head (currently ctc)
SHENAVA_DECODER=ctc

# --- Streaming --------------------------------------------------------------
SHENAVA_RIGHT_CONTEXT=13
SHENAVA_PARTIAL_INTERVAL_S=0.5
SHENAVA_REQUIRE_STREAMING=0
# Optional CUDA-graph streaming optimisation; eager is the reference path.
SHENAVA_CUDA_GRAPH_STREAMING=0

# --- Endpoint second pass ---------------------------------------------------
# off | greedy (default) | context (CTC beam + reviewed hotword bias)
SHENAVA_SECOND_PASS=greedy
SHENAVA_BEAM_SIZE=4

# --- Decoder-time hotwords (reviewed terminology only) ----------------------
# Empty = the general set only; e.g. cardiology, radiology, pulmonology.
SHENAVA_HOTWORD_SPECIALTY=
SHENAVA_HOTWORD_MAX=64
# Reviewed aliases / phonetic variants are opt-in and biased lower.
SHENAVA_HOTWORD_ALIASES=0
SHENAVA_HOTWORD_PHONETIC=0

# --- VAD --------------------------------------------------------------------
# Adaptive noise floor on top of the fixed thresholds (bounded, one-directional).
SHENAVA_VAD_ADAPTIVE=1

# --- Output -----------------------------------------------------------------
# overlay | inject | both (default) | clipboard | console
SHENAVA_OUTPUT_MODE=both
# auto | clipboard | keyboard
SHENAVA_INJECTOR_MODE=auto
SHENAVA_AUDIO_DEVICE=
SHENAVA_LOG_LEVEL=INFO
SHENAVA_DEBUG=0

# --- Benchmarking -----------------------------------------------------------
# Offline tooling only; the realtime app never cross-runs CTC and RNNT.
SHENAVA_BENCHMARK_MODE=0
