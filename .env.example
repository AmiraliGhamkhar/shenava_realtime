# Shenava realtime — example environment. Copy to .env and edit.
# Every key here is optional; the defaults in shenava_realtime/config.py apply
# when a key is absent. Exported shell variables always win over this file.
# .env is git-ignored (see .gitignore) — never commit real secrets/paths here.

# --- Model (sherpa-onnx streaming CTC; see models/shenava/README.md) --------
SHENAVA_ASR_BACKEND=sherpa_onnx_ctc
SHENAVA_MODEL_PATH=./models/shenava/model.int8.onnx
SHENAVA_TOKENS_PATH=./models/shenava/tokens.txt
# CPU only — this backend has no GPU/CUDA support.
SHENAVA_DEVICE=cpu
SHENAVA_NUM_THREADS=4
SHENAVA_SAMPLE_RATE=16000
# Validated against the loaded ONNX model at startup; mismatch is a clear error.
SHENAVA_FEATURE_DIM=80
# Only greedy_search is supported.
SHENAVA_DECODING_METHOD=greedy_search

# --- Streaming ----------------------------------------------------------
SHENAVA_PARTIAL_INTERVAL_S=0.5
# The real model is always streaming; this GATE should stay on in production.
SHENAVA_REQUIRE_STREAMING=1

# --- Endpoint second pass -------------------------------------------------
# off | greedy (default). "context" (CTC beam + hotword bias) was removed:
# sherpa-onnx exposes no raw emissions/tokenizer for it.
SHENAVA_SECOND_PASS=greedy

# --- VAD --------------------------------------------------------------------
# Adaptive noise floor on top of the fixed thresholds (bounded, one-directional).
SHENAVA_VAD_ADAPTIVE=1

# --- Output -----------------------------------------------------------------
# overlay | inject | both (default) | clipboard | console
SHENAVA_OUTPUT_MODE=both
# auto | clipboard | keyboard
SHENAVA_INJECTOR_MODE=auto
SHENAVA_AUDIO_DEVICE=
SHENAVA_LOG_LEVEL=INFO
SHENAVA_DEBUG=0

# --- Benchmarking -----------------------------------------------------------
# Offline tooling only.
SHENAVA_BENCHMARK_MODE=0
